<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_willmantech">
        <div class="container">
            
            <header>
                <h1>Factura de Venta</h1>
                <h3>WillmanTech S.L.</h3>
            </header>

            <hr/>

            <div class="datos-factura">
                <p><strong>Número de factura:</strong> <span t-field="doc.name"/></p>
                <p><strong>Fecha de emisión:</strong> <span t-field="doc.date"/></p>
            </div>

            <br/>

            <table border="1" cellpadding="5" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        
                        <th t-if="doc.invoice_line_ids and doc.invoice_line_ids[0].discount">
                            Descuento (%)
                        </th>
                        
                        <th>Subtotal</th>
                    </tr>
                </thead>
                
                <tbody>
                    <tr t-foreach="doc.invoice_line_ids" t-as="line">
                        <td><span t-field="line.name"/></td>
                        <td><span t-field="line.quantity"/></td>
                        <td><span t-field="line.price_unit"/></td>
                        
                        <td t-if="doc.invoice_line_ids and doc.invoice_line_ids[0].discount">
                            <span t-field="line.discount"/>
                        </td>
                        
                        <td><span t-field="line.price_subtotal"/></td>
                    </tr>
                </tbody>
            </table>

            <br/>

            <div style="float: right; text-align: right;">
                <p><strong>Total Neto:</strong> <span t-field="doc.amount_total"/></p>
            </div>

        </div>
    </template>
</odoo>
